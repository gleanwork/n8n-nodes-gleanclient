{
	"name": "@gleanwork/n8n-nodes-gleanclient",
	"version": "0.4.2",
	"description": "n8n nodes to interact with Glean",
	"keywords": [
		"n8n-community-node-package",
		"glean",
		"enterprise-search",
		"search",
		"trigger",
		"webhook"
	],
	"license": "MIT",
	"homepage": "https://www.glean.com",
	"author": {
		"name": "Glean",
		"email": "gleanwork@glean.com",
		"url": "https://www.glean.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gleanwork/n8n-nodes-gleanclient.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "n8n-node lint --fix",
		"format:check": "n8n-node lint",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"knip": "knip",
		"license:check": "node scripts/check-licenses.mjs",
		"lint:community": "eslint --no-config-lookup --config eslint.community.config.mjs nodes credentials"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GleanClientApi.credentials.js",
			"dist/credentials/GleanOAuth2Api.credentials.js",
			"dist/credentials/GleanTriggerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/GleanClient/GleanClient.node.js",
			"dist/nodes/GleanClientTrigger/GleanClientTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.29.0",
		"@n8n/node-cli": "^0.43.4",
		"@types/node": "^25.9.2",
		"@typescript-eslint/parser": "^8.35.0",
		"eslint": "9.32.0",
		"knip": "^5.0.0",
		"release-it": "^21.0.1",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}

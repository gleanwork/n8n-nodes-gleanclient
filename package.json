{
	"name": "@gleanwork/n8n-nodes-gleanclient",
	"version": "0.2.0",
	"description": "n8n nodes to interact with Glean",
	"keywords": [
		"n8n-community-node-package"
	],
	"license": "MIT",
	"homepage": "https://www.glean.com",
	"author": {
		"name": "Dejim Juang",
		"email": "dejim.juang@glean.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gleanwork/n8n-nodes-gleanclient.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"knip": "knip",
		"license:check": "node scripts/check-licenses.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GleanClientApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/GleanClient/GleanClient.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.40.3",
		"@types/node": "^26.1.1",
		"eslint": "10.7.0",
		"knip": "^6.26.0",
		"prettier": "3.9.5",
		"release-it": "^20.2.1",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"pnpm": {
		"overrides": {
			"form-data": ">=4.0.6",
			"lodash": ">=4.18.1"
		}
	}
}
